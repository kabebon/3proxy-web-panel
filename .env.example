# ============================================================
# 3proxy Web Panel — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
DB_NAME=panel
DB_USER=panel
DB_PASSWORD=your_strong_db_password_here

# --- Panel Admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# --- Session Secret (min 32 chars) ---
SECRET_KEY=change_this_to_a_random_32_char_string

# --- Panel bind + port (loopback by default; do NOT expose the panel directly) ---
PANEL_BIND=127.0.0.1
PANEL_PORT=8080

# --- Bot API (comma-separated bearer tokens; empty = API disabled) ---
API_TOKENS=

# --- Host shown in user credentials (aggregator public IP or domain) ---
PUBLIC_HOST=

# --- Subscription expiry reaper interval (seconds) ---
REAPER_SECONDS=30

# --- Upstream health checker: probes AI domains through every enabled upstream
#     (SOCKS5/HTTP CONNECT + TLS + HTTP). off | monitor | auto:
#     off     — no checks
#     monitor — record status + alert, no switching
#     auto    — DOWN upstreams leave routing instantly (group weight 0 /
#               sticky listeners re-pointed to a healthy upstream) + alert
HEALTHCHECK_MODE=auto
HEALTHCHECK_SECONDS=30
HEALTHCHECK_TIMEOUT=10
HEALTHCHECK_FAILS=1
HEALTHCHECK_TARGETS=api.openai.com:443,api.x.ai:443

# --- Admin alerts (Telegram); empty = alerts go to panel log only
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
